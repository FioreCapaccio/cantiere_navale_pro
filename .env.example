# Copia questo file in ".env" (nella cartella dati dell'app o accanto a main.py)
# e imposta solo i valori che vuoi cambiare.

# Ascolta solo sul computer locale (default)
HOST=127.0.0.1
# Per usare l'app anche da telefono/tablet in rete locale:
# HOST=0.0.0.0

# Porta web (default 8765)
# PORT=8765

# Utente amministratore creato al primo avvio
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123

# Apre il browser all'avvio (default: 1 nell'app pacchettizzata)
# OPEN_BROWSER=1
